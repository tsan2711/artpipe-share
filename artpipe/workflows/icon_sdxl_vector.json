{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{CKPT}}"
    },
    "_meta": {
      "title": "SDXL base 1.0"
    }
  },
  "8": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "clip": [
        "1",
        1
      ],
      "lora_name": "DD-vector-v2.safetensors",
      "strength_model": 0.8,
      "strength_clip": 0.8
    },
    "_meta": {
      "title": "flat: bỏ chuyển sắc, ra mảng màu phẳng"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{PROMPT}}",
      "clip": [
        "8",
        1
      ]
    },
    "_meta": {
      "title": "prompt (artpipe ghi vào đây)"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEGATIVE}}",
      "clip": [
        "8",
        1
      ]
    },
    "_meta": {
      "title": "negative (cfg > 1 thì mới có tác dụng)"
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "batch_size": 1
    },
    "_meta": {
      "title": "canvas — SDXL phải 1024, dùng run.py --gen-size 1024"
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{SEED}}",
      "steps": 25,
      "cfg": 7.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": [
        "8",
        0
      ],
      "positive": [
        "2",
        0
      ],
      "negative": [
        "3",
        0
      ],
      "latent_image": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "sampler (SDXL: 25 step, cfg 6 — negative mới ăn)"
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "5",
        0
      ],
      "vae": [
        "1",
        2
      ]
    },
    "_meta": {
      "title": "decode"
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "6",
        0
      ],
      "filename_prefix": "artpipe"
    },
    "_meta": {
      "title": "output"
    }
  }
}
